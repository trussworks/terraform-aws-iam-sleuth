#!/bin/bash

set -eu -o pipefail

ZIP_NAME=${ZIP_NAME:-deployment.zip}

pip install --require-hashes --no-deps --target ./reqs -r sleuth/requirements.txt
pushd reqs
zip -r9 "../$ZIP_NAME" .
popd
pushd sleuth
zip -r9 "../$ZIP_NAME" handler.py
zip -r9 "../$ZIP_NAME" -r sleuth/
popd

ls

echo "Packaging complete, saving as artifact."

echo "Calculating checksum."
sha256sum "$ZIP_NAME" > checksums.txt
ls
